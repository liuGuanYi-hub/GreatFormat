{
  "name": "greatformat",
  "version": "1.0.0",
  "description": "GreatFormat (太棒格式) - 疯狂钻石主题全本地离线文件格式转换器 (Word / PDF / 图片互转与原子重组)",
  "main": "electron-main.js",
  "bin": {
    "greatformat": "./cli.js",
    "dora": "./cli.js"
  },
  "scripts": {
    "start": "chcp 65001 >nul && electron .",
    "desktop": "chcp 65001 >nul && electron .",
    "cli": "chcp 65001 >nul && node cli.js",
    "test": "node tests/test-converters.js",
    "dist:portable": "electron-builder --win portable -c.win.signAndEditExecutable=false -c.forceCodeSigning=false"
  },
  "build": {
    "appId": "com.liuguanyi.greatformat",
    "productName": "GreatFormat",
    "copyright": "Copyright © 2026 liuGuanYi",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "forceCodeSigning": false,
    "win": {
      "icon": "src/assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "GreatFormat-Portable-${version}.${ext}"
    },
    "asar": true
  },
  "keywords": [
    "file-converter",
    "pdf-converter",
    "word-converter",
    "image-converter",
    "jojo",
    "crazy-diamond",
    "electron",
    "offline-tool"
  ],
  "author": "liuGuanYi",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.1.0",
    "docx": "^9.1.1",
    "mammoth": "^1.8.0",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^24.13.3"
  }
}
